# Copy to .env and fill in. Placeholders only; never commit real values.

# --- Backend (apps/api) ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://tokenguard:tokenguard@localhost:5432/tokenguard
ALLOWED_ORIGINS=["http://localhost:3000"]
DEMO_MODE=true
MYR_PER_USD_DEMO=4.70
PRICING_CATALOG_VERSION=demo-2025-10
SCHEDULER_SECRET=change-me

# Anthropic: leave the key empty to run in mock provider mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODE=auto

# Auth: Supabase in hosted mode; local dev uses DEV_JWT_SECRET (HS256).
SUPABASE_URL=
SUPABASE_JWKS_URL=
DEV_JWT_SECRET=dev-only-insecure-secret-change-me
# Supabase Auth user UUID to make workspace owner during bootstrap (hosted mode).
OWNER_AUTH_USER_ID=

# Required in production (long random strings). Dev falls back to DEV_JWT_SECRET.
CHAT_TOKEN_SECRET=
FINGERPRINT_SECRET=

# --- Frontend (apps/web) --- public values only, never secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
